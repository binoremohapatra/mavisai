# Text-to-Speech API Keys
# Copy this file to .env.local and add your API keys

# OpenAI TTS API Key
# Get from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key
# Get from: https://elevenlabs.io/app
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID
# Get from: https://elevenlabs.io/app/voices (click the ID icon next to your chosen voice)
# Example: "Sieu Muoi" voice ID
VITE_ELEVENLABS_VOICE_ID=your_voice_id_here

# Azure Cognitive Services Speech Key
# Get from: https://portal.azure.com/#blade/HubsExtension/BrowseResource/resourceType/Microsoft.CognitiveServices%2Faccounts
VITE_AZURE_SPEECH_KEY=your_azure_speech_key_here
VITE_AZURE_SPEECH_REGION=eastus

# TTS Provider Preference
# Options: openai, elevenlabs, azure, fallback
VITE_TTS_PROVIDER=elevenlabs

# Audio Settings
VITE_TTS_SAMPLE_RATE=22050
VITE_TTS_BITRATE=128000

# Backend API URL
VITE_API_BASE_URL=https://mavisai-core.onrender.com
